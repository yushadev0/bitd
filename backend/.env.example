# Copy this file to .env and fill in real values. Never commit the real .env file.

# Database. Local docker-compose uses Postgres (service "db"); a production
# deployment can point this at SQL Server instead, e.g.:
#   mssql+pyodbc://user:pass@host:1433/bitd?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes
DATABASE_URL=postgresql+psycopg://bitd:bitd@db:5432/bitd

# Auth
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
REMEMBER_TOKEN_EXPIRE_DAYS=30
# Only set to true behind HTTPS.
COOKIE_SECURE=false

# CORS - comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Set to the app's path prefix when served under a subpath, e.g. "/bitd"
# for https://example.com/bitd/ (nginx proxying /bitd/api/ to this service).
# Leave empty when served at the domain root.
PUBLIC_PATH_PREFIX=

# TMDB (https://www.themoviedb.org/settings/api) - use the "API Read Access Token"
TMDB_TOKEN=

# IGDB / Twitch (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Google Books (https://console.cloud.google.com/apis/credentials)
GOOGLE_BOOKS_KEY=

# SMTP - used to send password-reset OTP codes (Gmail App Password recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=B.I.T.D. Sistem
